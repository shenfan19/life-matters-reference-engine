# 复制为 .env 并按需修改（.env 已在 .gitignore，不会被提交）。
# 这些变量同时影响 GUI 后端（reference_engine/src/api_server.py）和 CLI（cli/）——
# 两者共用 reference_engine/src/paths.py 解析出的同一套路径，详见该文件。

# 模型库根目录。默认 <项目根>/models（即 models/ 符号链接指向的 life-matters-models/models）。
# LM_MODELS_PATH=

# CLI / GUI 本地输出根目录。默认 <项目根>/output。
# LM_OUTPUT_PATH=

# SCS（Software-as-a-Cloud-Service）模式：true 时禁止写操作，详见 ADR 0078。
# SCS_MODE=false

# 公网部署资源保护（P1/P2）：全局并发优化 job / 仿真 session 上限，超出返回 503。
# 详见 2026-06-25_task_prelaunch-publish-verification-checklist.md §4。
# LM_MAX_CONCURRENT_OPTS=2
# LM_MAX_CONCURRENT_SIMS=5

# 部署到公网 IP/域名时，把访问地址加进 CORS 白名单，否则浏览器会拦截前端请求。
# 本地开发不用填（localhost:5173/5174 已经默认放行）。逗号分隔可以填多个。
# 示例：LM_EXTRA_CORS_ORIGINS=http://123.45.67.89,https://your-domain.com
# LM_EXTRA_CORS_ORIGINS=
