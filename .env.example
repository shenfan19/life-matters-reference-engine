# 复制为 .env 并按需修改（.env 已在 .gitignore，不会被提交）。
# 这些变量同时影响 GUI 后端（sim_engine/src/api_server.py）和 CLI（sim_cli/）——
# 两者共用 sim_engine/src/paths.py 解析出的同一套路径，详见该文件。

# 模型库根目录。默认 <项目根>/models（即 models/ 符号链接指向的 b_lm_model/models）。
# LM_MODELS_PATH=

# CLI / GUI 本地输出根目录。默认 <项目根>/output。
# LM_OUTPUT_PATH=

# SCS（Software-as-a-Cloud-Service）模式：true 时禁止写操作，详见 ADR 0078。
# SCS_MODE=false
