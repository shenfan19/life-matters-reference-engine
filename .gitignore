# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
# Build artifacts
build/
dist/
release/
*.egg-info/
*.so

# Environment files
# .env
.venv/
venv/

# Node
node_modules

# AI
.claude/
CLAUDE.md
AGENTS.md

# Personal
_saved_/
*.code-workspace
messages.mo

# Models folder (model files live in the sibling life-matters-models repo,
# resolved via LM_MODELS_PATH in .env / reference_engine/src/paths.py; not
# tracked here). Anchored to repo root — an unanchored `models/` also matched
# `test_verification/models/` (the numeric regression test suite, named
# test_verify/ until 2026-07-21) at any depth, silently keeping it out of git
# entirely since it was first added (2026-06-19). Discovered 2026-07-10 while
# adding new tests there.
/models/

# CLI outputs (folder tracked, contents ignored)
output/*
!output/.gitkeep

# Ad hoc / AI-drafted scripts (analysis one-offs, not part of the reviewed
# verification suite) — mirrors the models/temp/ convention: scratch work
# stays gitignored until a human explicitly promotes it to a tracked path.
reference_engine/scripts/temp/
